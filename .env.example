# Copia este archivo a .env y ajusta los valores (.env no se versiona).
# Nunca pongas aquí contraseñas ni tokens reales: este archivo sí se sube al repositorio.

# Servidor de MLflow Tracking (make mlflow-server lo levanta en el puerto 5001)
MLFLOW_TRACKING_URI=http://127.0.0.1:5001

# Docker Compose (docker-compose.yml). Compose lee este .env para los puertos y límites;
# dentro de la red de Compose la API siempre usa http://mlflow:5001.
API_IMAGE=mibici-api:1.2
MLFLOW_PORT=5001
API_PORT=8000
# Workers de uvicorn y límites de recursos del contenedor de la API.
API_WORKERS=1
API_CPUS=2
API_MEMORY=2g
# Usuario con el que corre el servidor de MLflow; debe poder escribir mlflow.db y mlartifacts/.
# En Linux usa tu usuario: MLFLOW_UID=$(id -u) y MLFLOW_GID=$(id -g). En macOS/Windows no importa.
MLFLOW_UID=10001
MLFLOW_GID=10001
